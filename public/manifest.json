{
  "manifest_version": 3,
  "name": "Fib Ruler",
  "description": "A visual Fibonacci ruler overlay for any web page.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Fib Ruler",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": []
}
